# Server-only AI configuration. Never use NEXT_PUBLIC_ for these variables.
AI_ENABLED=true
AI_PROVIDER=deepseek
AI_API_KEY=REPLACE_WITH_DEEPSEEK_API_KEY
AI_MODEL_TEXT=deepseek-v4-flash
AI_FALLBACK_PROVIDER=gemini
AI_FALLBACK_API_KEY=REPLACE_WITH_GEMINI_API_KEY
AI_FALLBACK_MODEL_TEXT=gemini-2.5-flash
AI_MAX_TOKENS=2048
AI_TIMEOUT_MS=15000


# SAF-T(AO) — server-only. KLASSE currently exports Facturação (F), not accounting C/I.
SAFT_PRODUCT_ID=KLASSE/MoxiNexa
SAFT_PRODUCT_COMPANY_TAX_ID=REPLACE_WITH_SOFTWARE_PRODUCER_NIF
SAFT_PRODUCT_VERSION=1.0.0
SAFT_TAX_ACCOUNTING_BASIS=F

# Use 0 while the software is not AGT-validated. Once validated, use NNN/AGT/YYYY.
# A non-zero certificate activates the dedicated SAF-T RSA-1024/SHA1 hash chain
# and must start on a fresh fiscal series.
SAFT_SOFTWARE_CERTIFICATE_NUMBER=0
SAFT_HASH_CONTROL_VERSION=1

# Required only when SAFT_SOFTWARE_CERTIFICATE_NUMBER is non-zero.
# Keep these server-only; never expose as NEXT_PUBLIC_*.
SAFT_PRIVATE_KEY_PEM_B64=
